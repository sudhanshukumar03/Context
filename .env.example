# Server Configuration
PORT=8080
NODE_ENV=development
SESSION_SECRET=super-secret-session-key-for-local-dev-12345

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/context_db

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Google Gemini AI Configuration (availability and quotas depend on your account)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-free-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: OpenAI Configuration (Paid)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Local API demo: omit CLERK_SECRET_KEY and set ALLOW_DEV_AUTH_BYPASS=true.
# Frontend demo also needs VITE_ALLOW_DEV_AUTH_BYPASS=true (development only).
# Production: set ALLOWED_ORIGINS to the deployed site's HTTPS origin.
ALLOW_DEV_AUTH_BYPASS=false
ALLOWED_ORIGINS=http://localhost:3000

