# Copy outside version control. Never put secret values in public VITE variables.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
ALLOW_DEV_AUTH_BYPASS=false
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST/context?sslmode=verify-full
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=https://YOUR_DOMAIN
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY
CLERK_SECRET_KEY=sk_live_YOUR_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-3.8-flash
# Native transport avoids the compatibility endpoint; model access/quota still apply.
GEMINI_TRANSPORT=native
