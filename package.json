{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "vitest run",
    "test:container": "node scripts/test-container.mjs",
    "local:start": "powershell -NoProfile -File scripts/local-test.ps1 -Action Start",
    "local:status": "powershell -NoProfile -File scripts/local-test.ps1 -Action Status",
    "local:smoke": "powershell -NoProfile -File scripts/local-test.ps1 -Action Smoke",
    "local:stop": "powershell -NoProfile -File scripts/local-test.ps1 -Action Stop",
    "local:clerk-setup": "node scripts/prepare-local-clerk.mjs",
    "local:clerk-check": "node scripts/local-test-server.mjs check-auth clerk",
    "local:clerk-verify": "node scripts/verify-local-clerk.mjs",
    "local:clerk": "powershell -NoProfile -File scripts/local-test.ps1 -Action Start -AuthMode clerk",
    "local:demo": "powershell -NoProfile -File scripts/local-test.ps1 -Action Start -AuthMode demo",
    "local:ai-setup": "node scripts/prepare-local-ai.mjs",
    "local:ai-check": "node scripts/verify-local-ai.mjs",
    "local:ai-verify": "node scripts/verify-local-ai.mjs --generate",
    "local:ai-on": "powershell -NoProfile -File scripts/local-test.ps1 -Action Start -AiMode gemini",
    "local:ai-off": "powershell -NoProfile -File scripts/local-test.ps1 -Action Start -AiMode off",
    "local:backup-check": "node scripts/local-backup-check.mjs",
    "local:load-check": "node scripts/local-load-check.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "local:migrate": "powershell -NoProfile -File scripts/local-test.ps1 -Action Migrate"
  },
  "private": true,
  "devDependencies": {
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.18.0"
}
